VIVADO ?= vivado
GUI_XPR := build/gui/kr260.xpr

.PHONY: project gui build clean

# Create the GUI project (only if it doesn't already exist).
project: $(GUI_XPR)

$(GUI_XPR):
	mkdir -p build
	cd build && $(VIVADO) -mode batch -source ../tcl/project.tcl

# Open the GUI project, creating it first if needed.
gui: $(GUI_XPR)
	cd build && $(VIVADO) -mode gui -source ../tcl/helpers.tcl gui/kr260.xpr &

# Build provenance, captured when make starts. out/ is excluded from the dirty
# check since it only ever holds build results.
GIT_HASH    := $(shell git rev-parse HEAD)
GIT_BRANCH  := $(shell git rev-parse --abbrev-ref HEAD)
GIT_CHANGES := $(shell git status --porcelain -- . ':!out')
BUILD_START := $(shell date --iso-8601=seconds)

# Full headless build from a clean project; products land in out/.
# Refuses to run with uncommitted changes unless ALLOW_DIRTY=1.
build:
ifneq ($(GIT_CHANGES),)
ifneq ($(ALLOW_DIRTY),1)
	@echo "error: uncommitted changes outside out/ (commit them, or pass ALLOW_DIRTY=1):"
	@git status --short -- . ':!out'
	@exit 1
endif
endif
	mkdir -p build
	cd build && $(VIVADO) -mode batch -source ../tcl/build.tcl
	cp build/vivado.log out/logs/vivado.log
	@{ \
	    echo "# Build Provenance"; \
	    echo; \
	    echo "Generated by \`make build\`; do not edit."; \
	    echo; \
	    echo "| | |"; \
	    echo "|---|---|"; \
	    echo "| Commit | \`$(GIT_HASH)\` |"; \
	    echo "| Branch | \`$(GIT_BRANCH)\` |"; \
	    echo "| Tree | $(if $(GIT_CHANGES),**dirty**,clean) |"; \
	    echo "| Started | $(BUILD_START) |"; \
	    echo "| Finished | $$(date --iso-8601=seconds) |"; \
	    echo "| Vivado | $$(grep -m1 -o 'Vivado v[0-9.]*' build/vivado.log | cut -d' ' -f2) |"; \
	    echo "| Host | $$(hostname) |"; \
	    if [ -n "$(GIT_CHANGES)" ]; then \
	        echo; \
	        echo "Uncommitted changes at build time:"; \
	        echo; \
	        echo '```'; \
	        git status --short -- . ':!out'; \
	        echo '```'; \
	    fi; \
	} > out/README.md

clean:
	git clean -fXd -e '!temp/'
